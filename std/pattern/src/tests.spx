@id("std.pattern.tests.malformed-carrier")
fn test_malformed_carrier() -> i64
{
    let storage = bytes_zeroed(3072usize);
    let malformed = Matcher { storage: storage, position: 3073usize };
    let carrier_rejected = !result_valid(malformed) && result_valid(malformed) == frozen_result_valid(malformed);
    // Header padding must still report the first corrupt byte, and the
    // original two-unit preflight must win before an unread corrupt byte.
    let mut header = bytes_zeroed(3072usize);
    header = bytes_set(header, 0usize, 83u8);
    header = bytes_set(header, 1usize, 80u8);
    header = bytes_set(header, 2usize, 65u8);
    header = bytes_set(header, 3usize, 67u8);
    header = bytes_set(header, 4usize, 1u8);
    header = bytes_set(header, 5usize, 1u8);
    header = bytes_set(header, 9usize, 1u8);
    header = bytes_set(header, 63usize, 1u8);
    let input = "";
    let input_text = string_as_str(input);
    let input_view = str_as_bytes(input_text);
    let checked: Matcher = full_match(Matcher { storage: header, position: 0usize }, input_view, 262144usize);
    let corrupt = result_valid(checked) == frozen_result_valid(checked) && result_valid(checked) && status(checked) == 3usize && reason(checked) == 2usize && detail(checked) == 9usize && detail_domain(checked) == 2usize && work_used(checked) == 52usize;
    let checked_preflight = full_match(checked, input_view, 50usize);
    let preflight = result_valid(checked_preflight) == frozen_result_valid(checked_preflight) && result_valid(checked_preflight) && status(checked_preflight) == 4usize && reason(checked_preflight) == 7usize && detail(checked_preflight) == 0usize && work_used(checked_preflight) == 50usize;
    if carrier_rejected && corrupt && preflight { 0 } else { 1 }
}

@id("std.pattern.tests.bounded-reentry")
fn test_bounded_reentry() -> i64
{
    let pattern = "([A-Za-z-]+):[ \\x09]*([^\\x0D\\x0A]*)";
    let pattern_text = string_as_str(pattern);
    let pattern_view = str_as_bytes(pattern_text);
    let first = "A: x";
    let first_text = string_as_str(first);
    let first_view = str_as_bytes(first_text);
    let second = "XY: z";
    let second_text = string_as_str(second);
    let second_view = str_as_bytes(second_text);
    let mut matcher: Matcher = compile(make(), pattern_view, 262144usize);
    let compiled = result_valid(matcher) && status(matcher) == 0usize;
    let mut iteration = 0usize;
    let mut correct = 0usize;
    if compiled { while iteration < 2usize { if iteration == 0usize { matcher = full_match(matcher, first_view, 262144usize); 0 } else { matcher = full_match(matcher, second_view, 262144usize); 0 } if result_valid(matcher) && status(matcher) == 1usize && capture_count(matcher) == 2usize && work_used(matcher) <= 262144usize { let key_end = if iteration == 0usize { 1usize } else { 2usize }; let value_start = if iteration == 0usize { 3usize } else { 4usize }; let value_end = if iteration == 0usize { 4usize } else { 5usize }; if capture_start(matcher, 0usize) == 0usize && capture_end(matcher, 0usize) == key_end && capture_start(matcher, 1usize) == value_start && capture_end(matcher, 1usize) == value_end && reason(matcher) == 0usize && detail(matcher) == 0usize && detail_domain(matcher) == 0usize { correct = correct + 1usize; 0 } else { 0 } } else { 0 } iteration = iteration + 1usize; 0 } }
    if compiled && correct == 2usize { 0 } else { 1 }
}
