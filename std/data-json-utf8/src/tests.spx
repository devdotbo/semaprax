module std.data.json.utf8.tests;
use function @id("std.data.json.utf8.at_in") from std.data.json.utf8 as at_in;
use function @id("std.data.json.utf8.at_is") from std.data.json.utf8 as at_is;
use function @id("std.data.json.utf8.continuation_at") from std.data.json.utf8 as continuation_at;
use function @id("std.data.json.utf8.is_shortest") from std.data.json.utf8 as is_shortest;
use function @id("std.data.json.utf8.is_surrogate") from std.data.json.utf8 as is_surrogate;
use function @id("std.data.json.utf8.is_utf8") from std.data.json.utf8 as is_utf8;
use function @id("std.data.json.utf8.offset_at") from std.data.json.utf8 as offset_at;
use function @id("std.data.json.utf8.scalar_at") from std.data.json.utf8 as scalar_at;
use function @id("std.data.json.utf8.sequence_end") from std.data.json.utf8 as sequence_end;
use function @id("std.data.json.utf8.sequence_kind") from std.data.json.utf8 as sequence_kind;
use function @id("std.data.json.utf8.utf8_end") from std.data.json.utf8 as utf8_end;

@id("std.data.json.utf8.tests.leads")
fn leads() -> bool
{
    let sample = [65u8, 194u8, 162u8, 226u8, 130u8, 172u8, 240u8, 144u8, 141u8, 136u8];
    let view = array_as_slice(sample);
    at_is(view, 0usize, 65u8) && !at_is(view, 0usize, 66u8) && at_in(view, 1usize, 194u8, 223u8) && !at_in(view, 0usize, 194u8, 223u8) && !at_in(view, 10usize, 0u8, 255u8) && offset_at(view, 0usize, 0u8, 127) == 65 && offset_at(view, 1usize, 194u8, 29) == 0 && offset_at(view, 3usize, 224u8, 15) == 2 && offset_at(view, 6usize, 240u8, 4) == 0 && offset_at(view, 0usize, 194u8, 29) == -1 && continuation_at(view, 2usize) == 34 && continuation_at(view, 0usize) == -1
}

@id("std.data.json.utf8.tests.widths")
fn widths() -> bool
{
    let sample = [65u8, 194u8, 162u8, 226u8, 130u8, 172u8, 240u8, 144u8, 141u8, 136u8];
    let view = array_as_slice(sample);
    sequence_kind(view, 0usize) == 1 && sequence_kind(view, 1usize) == 2 && sequence_kind(view, 3usize) == 3 && sequence_kind(view, 6usize) == 4 && sequence_kind(view, 2usize) == 0 && sequence_kind(view, 10usize) == 0 && sequence_end(view, 0usize) == 1usize && sequence_end(view, 1usize) == 3usize && sequence_end(view, 3usize) == 6usize && sequence_end(view, 6usize) == 10usize
}

@id("std.data.json.utf8.tests.scalars")
fn scalars() -> bool
{
    let sample = [65u8, 194u8, 162u8, 226u8, 130u8, 172u8, 240u8, 144u8, 141u8, 136u8];
    let view = array_as_slice(sample);
    scalar_at(view, 0usize) == 65 && scalar_at(view, 1usize) == 162 && scalar_at(view, 3usize) == 8364 && scalar_at(view, 6usize) == 66376 && scalar_at(view, 2usize) == -1 && scalar_at(view, 10usize) == -1
}

@id("std.data.json.utf8.tests.rejections")
fn rejections() -> bool
{
    let overlong = [192u8, 128u8];
    let padded = [224u8, 128u8, 175u8];
    let cesu = [237u8, 160u8, 128u8];
    let truncated = [226u8, 130u8];
    let beyond = [244u8, 144u8, 128u8, 128u8];
    let short = array_as_slice(overlong);
    let wide = array_as_slice(padded);
    let paired = array_as_slice(cesu);
    let cut = array_as_slice(truncated);
    let over = array_as_slice(beyond);
    scalar_at(short, 0usize) == -1 && scalar_at(wide, 0usize) == -1 && scalar_at(paired, 0usize) == -1 && scalar_at(cut, 0usize) == -1 && scalar_at(over, 0usize) == -1 && !is_utf8(short) && !is_utf8(wide) && !is_utf8(paired) && !is_utf8(cut) && !is_utf8(over)
}

@id("std.data.json.utf8.tests.surrogates")
fn surrogates() -> bool
{
    is_surrogate(55296) && is_surrogate(57343) && !is_surrogate(55295) && !is_surrogate(57344) && !is_surrogate(0)
}

@id("std.data.json.utf8.tests.boundaries")
fn boundaries() -> bool
{
    let top = [244u8, 143u8, 191u8, 191u8];
    let highest = array_as_slice(top);
    is_shortest(1, 127) && !is_shortest(1, 128) && is_shortest(2, 128) && !is_shortest(2, 127) && is_shortest(3, 2048) && !is_shortest(3, 55296) && is_shortest(4, 1114111) && !is_shortest(4, 1114112) && !is_shortest(0, 0) && scalar_at(highest, 0usize) == 1114111
}

@id("std.data.json.utf8.tests.documents")
fn documents() -> bool
{
    let sample = [65u8, 194u8, 162u8, 226u8, 130u8, 172u8, 240u8, 144u8, 141u8, 136u8];
    let broken = [65u8, 66u8, 226u8, 130u8, 67u8];
    let view = array_as_slice(sample);
    let mixed = array_as_slice(broken);
    utf8_end(view, 0usize) == 10usize && utf8_end(view, 1usize) == 10usize && utf8_end(view, 6usize) == 10usize && utf8_end(view, 12usize) == 10usize && is_utf8(view) && utf8_end(mixed, 0usize) > byte_len(mixed) && utf8_end(mixed, 0usize) - byte_len(mixed) - 1usize == 2usize && !is_utf8(mixed)
}

@id("std.data.json.utf8.tests.offset_case")
fn offset_case(input: borrow Slice<u8>, index: usize, base: u8, span: i64, expected: i64) -> i64
    requires span >= 0 && span <= 127
{
    let wanted = if expected >= 0 && expected <= span { expected } else { -1 };
    let present = offset_at(input, index, base, span);
    let absent = offset_at(input, byte_len(input), base, span);
    if present == wanted && absent == -1 { 0 } else { 1 }
}

@id("std.data.json.utf8.tests.all_offsets")
fn all_offsets() -> bool
{
    let bytes = [0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8, 32u8, 33u8, 34u8, 35u8, 36u8, 37u8, 38u8, 39u8, 40u8, 41u8, 42u8, 43u8, 44u8, 45u8, 46u8, 47u8, 48u8, 49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8, 57u8, 58u8, 59u8, 60u8, 61u8, 62u8, 63u8, 64u8, 65u8, 66u8, 67u8, 68u8, 69u8, 70u8, 71u8, 72u8, 73u8, 74u8, 75u8, 76u8, 77u8, 78u8, 79u8, 80u8, 81u8, 82u8, 83u8, 84u8, 85u8, 86u8, 87u8, 88u8, 89u8, 90u8, 91u8, 92u8, 93u8, 94u8, 95u8, 96u8, 97u8, 98u8, 99u8, 100u8, 101u8, 102u8, 103u8, 104u8, 105u8, 106u8, 107u8, 108u8, 109u8, 110u8, 111u8, 112u8, 113u8, 114u8, 115u8, 116u8, 117u8, 118u8, 119u8, 120u8, 121u8, 122u8, 123u8, 124u8, 125u8, 126u8, 127u8, 128u8, 129u8, 130u8, 131u8, 132u8, 133u8, 134u8, 135u8, 136u8, 137u8, 138u8, 139u8, 140u8, 141u8, 142u8, 143u8, 144u8, 145u8, 146u8, 147u8, 148u8, 149u8, 150u8, 151u8, 152u8, 153u8, 154u8, 155u8, 156u8, 157u8, 158u8, 159u8, 160u8, 161u8, 162u8, 163u8, 164u8, 165u8, 166u8, 167u8, 168u8, 169u8, 170u8, 171u8, 172u8, 173u8, 174u8, 175u8, 176u8, 177u8, 178u8, 179u8, 180u8, 181u8, 182u8, 183u8, 184u8, 185u8, 186u8, 187u8, 188u8, 189u8, 190u8, 191u8, 192u8, 193u8, 194u8, 195u8, 196u8, 197u8, 198u8, 199u8, 200u8, 201u8, 202u8, 203u8, 204u8, 205u8, 206u8, 207u8, 208u8, 209u8, 210u8, 211u8, 212u8, 213u8, 214u8, 215u8, 216u8, 217u8, 218u8, 219u8, 220u8, 221u8, 222u8, 223u8, 224u8, 225u8, 226u8, 227u8, 228u8, 229u8, 230u8, 231u8, 232u8, 233u8, 234u8, 235u8, 236u8, 237u8, 238u8, 239u8, 240u8, 241u8, 242u8, 243u8, 244u8, 245u8, 246u8, 247u8, 248u8, 249u8, 250u8, 251u8, 252u8, 253u8, 254u8, 255u8];
    let input = array_as_slice(bytes);
    let mut expected = 0;
    let mut failed = 0;
    while expected < 256 {
        let index = usize_from_i64(expected);
        failed = failed + offset_case(input, index, 0u8, 0, expected);
        failed = failed + offset_case(input, index, 0u8, 127, expected);
        failed = failed + offset_case(input, index, 128u8, 63, expected - 128);
        failed = failed + offset_case(input, index, 128u8, 127, expected - 128);
        failed = failed + offset_case(input, index, 194u8, 29, expected - 194);
        failed = failed + offset_case(input, index, 224u8, 15, expected - 224);
        failed = failed + offset_case(input, index, 240u8, 4, expected - 240);
        failed = failed + offset_case(input, index, 255u8, 127, expected - 255);
        expected = expected + 1;
        0
    }
    failed == 0
}

@id("std.data.json.utf8.tests.main")
fn main() -> i64
{
    let mut failed = 0;
    failed = failed + if leads() { 0 } else { 1 };
    failed = failed + if widths() { 0 } else { 2 };
    failed = failed + if scalars() { 0 } else { 4 };
    failed = failed + if rejections() { 0 } else { 8 };
    failed = failed + if surrogates() { 0 } else { 16 };
    failed = failed + if boundaries() { 0 } else { 32 };
    failed = failed + if documents() { 0 } else { 64 };
    failed = failed + if all_offsets() { 0 } else { 128 };
    failed
}
