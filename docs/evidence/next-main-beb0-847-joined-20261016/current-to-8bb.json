    "source": "src/workspace_graph/function_alias/before_core.rs",
    "checkpoint_revision": "8bb9f5b7b99e1e71a797460c46180daf716b234b",
    "archive": "docs/evidence/next-main-beb0-847-joined-20261016/before/src/workspace_graph/function_alias/before_core.rs",
    "current_sha256": "17442fc7c7d6023617ea0f84a57564ac779bf0e4882963f29133ce9c46c89578",
    "original_sha256": "aff5a461fb9418b07a4b107d991397c2ee7abbbd94f455bc6e6935457f0f7c71",
    "edits": [
      {
        "new": "#[cfg(test)]\n#[path = \"before_core/tests.rs\"]\nmod tests;\n\n// Test-only selection preserves the complete old constructor above. It has no\n// cache, quota mutation, warmup or production configuration surface.\nthread_local! {\n    static PARITY: std::cell::Cell<Option<(bool, usize)>> = const { std::cell::Cell::new(None) };\n}\npub(in crate::workspace_graph) fn selected() -> bool {\n    PARITY.with(|state| state.get().is_some_and(|(old, _)| old))\n}\npub(in crate::workspace_graph) fn borrowed_entry() {\n    PARITY.with(|state| {\n        if let Some((old, count)) = state.get() {\n            assert!(\n                !old,\n                \"the independent old constructor must never borrow alias payloads\"\n            );\n            state.set(Some((old, count + 1)));\n        }\n    });\n}\nfn parity_run<T>(old: bool, run: impl FnOnce() -> T) -> (T, usize) {\n    struct Restore(Option<(bool, usize)>);\n    impl Drop for Restore {\n        fn drop(&mut self) {\n            PARITY.with(|state| state.set(self.0));\n        }\n    }\n    let _restore = Restore(PARITY.with(|state| state.replace(Some((old, 0)))));\n    let result = run();\n    let count = PARITY.with(|state| state.get().unwrap().1);\n    (result, count)\n}\n",
        "old": "#[cfg(test)]\n#[path = \"before_core/tests.rs\"]\nmod tests;\n"
      },
      {
        "new": "use crate::workspace_graph::*;\n// Keep the source-authority inputs explicit at this audited construction boundary.\n#[allow(clippy::too_many_arguments)]\npub(in crate::workspace_graph) fn build_resolved_core_current(\n    programs: &[Program],\n    module_paths: &BTreeMap<&str, &str>,\n    dependency_depths: &BTreeMap<&str, usize>,\n",
        "old": "use crate::workspace_graph::*;\n// Keep the source-authority inputs explicit at this audited construction boundary.\n#[allow(clippy::too_many_arguments)]\npub(super) fn build_resolved_core_current(\n    programs: &[Program],\n    module_paths: &BTreeMap<&str, &str>,\n    dependency_depths: &BTreeMap<&str, usize>,\n"
      }
    ]
  },
  {
    "source": "src/workspace_graph/function_alias/before_core/tests.rs",
    "checkpoint_revision": "8bb9f5b7b99e1e71a797460c46180daf716b234b",
    "archive": "docs/evidence/next-main-beb0-847-joined-20261016/before/src/workspace_graph/function_alias/before_core/tests.rs",
    "current_sha256": "61812a8aa9cad5e4360a59eee02a8846835cb21dc396d7f1d22a2f2e1e53a697",
    "original_sha256": "cbb40b098b7dc3b1752677e2357770ab33bfa4c3f5f4e83a274b19675ee07d5c",
    "edits": [
      {
        "new": "        assert!(!m.invalid && m.live == 0 && m.allocated == m.freed);\n    }\n}\n\n#[test]\nfn actual_borrowed_alias_project_keeps_complete_sources_graph_and_image_of_old_core() {\n    use crate::project::{ProjectManifest, ProjectSemanticImage};\n    use crate::semantic_workspace::SemanticWorkspaceSource;\n    use std::sync::Arc;\n    const MANIFEST: &str = r#\"schema = \"semaprax.manifest.v1\"\n[package]\nname = \"alias-parity\"\nversion = \"1.0.0\"\n[modules]\nentry = \"alias.current\"\nsources = [\"src/app.spx\", \"src/tests.spx\"]\ntests = [\"alias.tests\"]\n[exports]\nweb = [\"alias.current.main\"]\n[dependencies]\nstd.collections = \"=0.1.0\"\n\"#;\n    const TESTS: &str = r#\"module alias.tests;\nuse function @id(\"alias.current.main\") from alias.current as current;\n@id(\"alias.tests.main\") fn main()->i64 {if current()==42 {0} else {1}}\n\"#;\n    let build = || {\n        let canonical =\n            |text: &str, path: &str| crate::format::canonical(&crate::parse(text, path).unwrap());\n        let manifest = ProjectManifest::parse(MANIFEST).unwrap();\n        let sources = vec![\n            SemanticWorkspaceSource::new(\n                \"src/app.spx\".to_owned(),\n                canonical(CALLER, \"src/app.spx\"),\n            ),\n            SemanticWorkspaceSource::new(\n                \"src/tests.spx\".to_owned(),\n                canonical(TESTS, \"src/tests.spx\"),\n            ),\n        ];\n        Arc::new(crate::project::rebuild_owned_revision(manifest, sources).unwrap())\n    };\n    // No preparatory build/cache warming: each side performs its actual full\n    // Project preflight, core selection, source retention, graph and admission.\n    let (old, old_borrowed) = super::parity_run(true, build);\n    let (current, current_borrowed) = super::parity_run(false, build);\n    assert_eq!(old_borrowed, 0);\n    assert!(\n        current_borrowed > 0,\n        \"fallback is not evidence of the optimized borrowed-alias route\"\n    );\n    assert_eq!(\n        old.manifest().to_canonical_toml(),\n        current.manifest().to_canonical_toml()\n    );\n    assert_eq!(old.workspace_manifest(), current.workspace_manifest());\n    assert_eq!(old.workspace_revision(), current.workspace_revision());\n    assert_eq!(old.project_revision(), current.project_revision());\n    let facts = |revision: &crate::project::ProjectRevision| {\n        revision\n            .sources()\n            .iter()\n            .map(|source| {\n                (\n                    source.path().to_owned(),\n                    source.source().to_owned(),\n                    source.source_graph_schema().to_owned(),\n                    source.source_revision().to_owned(),\n                    source.source_digest().to_owned(),\n                )\n            })\n            .collect::<Vec<_>>()\n    };\n    assert_eq!(facts(&old), facts(&current));\n    assert_eq!(old.semantic_graph(), current.semantic_graph());\n    assert_eq!(old.semantic_graph_digest(), current.semantic_graph_digest());\n    let old_image = ProjectSemanticImage::derive(Arc::clone(&old), old.project_revision()).unwrap();\n    let current_image =\n        ProjectSemanticImage::derive(Arc::clone(&current), current.project_revision()).unwrap();\n    assert_eq!(old_image.to_json(), current_image.to_json());\n    assert_eq!(old_image.image_digest(), current_image.image_digest());\n    eprintln!(\"847 actual borrowed Project parity entries={current_borrowed} graph={} image={} graph_bytes={} image_bytes={}\",\n        current.semantic_graph_digest(), current_image.image_digest(), current.semantic_graph().len(), current_image.to_json().len());\n    drop((old_image, current_image, old, current));\n}\n",
        "old": "        assert!(!m.invalid && m.live == 0 && m.allocated == m.freed);\n    }\n}\n"
      }
