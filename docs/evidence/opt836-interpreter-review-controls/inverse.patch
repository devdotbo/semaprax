-//! Checked-source construction and complete real Drop surround the private
-//! runtime boundary. Only hostile Arc/generation state is injected here; no
-//! source primitive, unchecked HIR or substitute store is introduced.
-use crate::interpreter::*;
-use crate::test_allocation_observer::{measure, Metrics};
-
-const SOURCE: &str = r#"module update.runtime;
-@id("update.row") record Row {
- @id("update.row.bytes") bytes:Bytes,
- @id("update.row.name") name:string,
- @id("update.row.count") count:i64,
- @id("update.row.spare32") spare32:f32,
- @id("update.row.spare64") spare64:f64,
-}
-@id("update.make") fn make(spare32:f32,spare64:f64)->Vec<Row> {
- let row=Row{bytes:bytes_zeroed(3usize),name:"N\u{0}\u{e9}",count:7,spare32:spare32,spare64:spare64};
- vec_push<Row>(vec_with_capacity<Row>(1usize),row)
-}
-@id("update.apply") fn apply(rows:own Vec<Row>)->Vec<Row> {
- vec_update_field<Row>(rows,0usize,9,"count")
-}
-@id("update.main") fn main()->i64 {0}
-"#;
-
-fn program() -> hir::ResolvedProgram {
-    let program = hir::resolve(&crate::check(SOURCE, "update-runtime.spx").unwrap()).unwrap();
-    hir::validate(&program).unwrap();
-    program
-}
-fn function<'a>(program: &'a hir::ResolvedProgram, id: &str) -> &'a ResolvedFunction {
-    program
-        .functions
-        .iter()
-        .find(|f| f.id.as_str() == id)
-        .unwrap()
-}
-fn make(
-    evaluator: &mut Evaluator<'_>,
-    program: &hir::ResolvedProgram,
-    bits32: u32,
-    bits64: u64,
-) -> Arc<owned_vec::OwnedVecValue> {
-    let make = function(program, "update.make");
-    let values = vec![
-        (
-            make.params[0].id.clone(),
-            Value::Float32(f32::from_bits(bits32)),
-        ),
-        (
-            make.params[1].id.clone(),
-            Value::Float64(f64::from_bits(bits64)),
-        ),
-    ];
-    let result = evaluator.call_frame(make, values, 0);
-    let Ok(Value::Vec(vector)) = result else {
-        panic!("{result:?}")
-    };
-    vector
-}
-fn apply(
-    evaluator: &mut Evaluator<'_>,
-    program: &hir::ResolvedProgram,
-    vector: Arc<owned_vec::OwnedVecValue>,
-) -> Result<Value, Flow> {
-    let apply = function(program, "update.apply");
-    evaluator.call_frame(
-        apply,
-        vec![(apply.params[0].id.clone(), Value::Vec(vector))],
-        0,
-    )
-}
-fn row(vector: &owned_vec::OwnedVecValue) -> &Arc<OwnedRecordValue> {
-    let [Value::Record(row)] = vector.values.as_slice() else {
-        panic!("row")
-    };
-    row
-}
-fn field<'a>(row: &'a OwnedRecordValue, id: &str) -> &'a Value {
-    row.fields
-        .iter()
-        .find(|(key, _)| key.as_str() == id)
-        .unwrap()
-        .1
-}
-#[derive(Debug, Eq, PartialEq)]
-struct RowSnapshot {
-    carrier: usize,
-    string: usize,
-    string_len: usize,
-    bytes: usize,
-    bytes_len: usize,
-    byte_owner: u32,
-    count: i64,
-    spare32: u32,
-    spare64: u64,
-}
-fn snapshot(row: &Arc<OwnedRecordValue>) -> RowSnapshot {
-    let Value::String(name) = field(row, "update.row.name") else {
-        panic!("String")
-    };
-    let Value::Bytes(bytes) = field(row, "update.row.bytes") else {
-        panic!("Bytes")
-    };
-    let Value::Int(count) = field(row, "update.row.count") else {
-        panic!("count")
-    };
-    let Value::Float32(spare32) = field(row, "update.row.spare32") else {
-        panic!("f32")
-    };
-    let Value::Float64(spare64) = field(row, "update.row.spare64") else {
-        panic!("f64")
-    };
-    assert_eq!(name.as_bytes(), b"N\0\xc3\xa9");
-    assert_eq!(bytes.bytes.as_ref(), &[0, 0, 0]);
-    RowSnapshot {
-        carrier: Arc::as_ptr(row) as usize,
-        string: name.as_ptr() as usize,
-        string_len: name.len(),
-        bytes: bytes.bytes.as_ptr() as usize,
-        bytes_len: bytes.bytes.len(),
-        byte_owner: bytes.allocation,
-        count: *count,
-        spare32: spare32.to_bits(),
-        spare64: spare64.to_bits(),
-    }
-}
-fn balanced(metrics: Metrics) {
-    assert!(!metrics.invalid, "{metrics:?}");
-    assert_eq!(metrics.live, 0, "{metrics:?}");
-    assert_eq!(metrics.allocated, metrics.freed, "{metrics:?}");
-}
-fn counters(evaluator: &Evaluator<'_>) -> (u32, u64, (u64, u64)) {
-    (
-        evaluator.next_byte_allocation,
-        evaluator.allocated_byte_payload,
-        evaluator.utf8_materialization_budget.usage(),
-    )
-}
