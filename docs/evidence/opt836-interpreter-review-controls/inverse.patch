-#[test]
-fn generation_overflow_is_selected_before_row_alias_and_survives_complete_owner_settlement() {
-    let program = program();
-    let admitted = program
-        .functions
-        .iter()
-        .map(|f| (f.id.as_str(), f))
-        .collect();
-    let mut evaluator = Evaluator::new_prepared(
-        FunctionLookup::Borrowed(&admitted),
-        BTreeMap::new(),
-        &program.declarations,
-        100_000,
-        0,
-        PreparedCancellation::Never,
-    );
-    evaluator.utf8_materialization_budget = Utf8MaterializationBudget::fixed();
-    let ((), metrics) = measure(|| {
-        let mut vector = make(&mut evaluator, &program, 0xff80_0000, 0x7ff8_0000_0000_0042);
-        // Trusted hostile-carrier fixture only. Construction, parameter staging,
-        // update dispatch and all settlement still use their ordinary receivers.
-        Arc::get_mut(&mut vector).unwrap().generation = u64::MAX;
-        let witness = Arc::clone(row(&vector));
-        let expected = snapshot(&witness);
-        let paid = counters(&evaluator);
-        let result = apply(&mut evaluator, &program, vector);
-        // Row alias would independently refuse later. It cannot replace the
-        // already selected generation-overflow invariant failure.
-        assert!(
-            matches!(
-                result,
-                Err(Flow::Guard("scalar update generation overflow"))
-            ),
-            "{result:?}"
-        );
-        assert_eq!(snapshot(&witness), expected);
-        assert_eq!(Arc::strong_count(&witness), 1);
-        assert_eq!(counters(&evaluator), paid);
-        assert!(crate::test_allocation_observer::live_bytes_matching(|p| p == expected.string) > 0);
-        drop(witness);
-        assert_eq!(
-            crate::test_allocation_observer::live_bytes_matching(|p| p == expected.string),
-            0
-        );
-        // Actual source-frame and original owner Drop leave the exact guard
-        // selected; no replacement language status or result is manufactured.
-        assert!(matches!(
-            result,
-            Err(Flow::Guard("scalar update generation overflow"))
-        ));
-    });
-    balanced(metrics);
-}
