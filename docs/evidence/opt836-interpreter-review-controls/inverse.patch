-#[test]
-fn aliased_vector_and_row_are_refused_before_the_scalar_store_and_drop_once() {
-    let program = program();
-    let admitted = program
-        .functions
-        .iter()
-        .map(|f| (f.id.as_str(), f))
-        .collect();
-    for alias_vector in [true, false] {
-        let mut evaluator = Evaluator::new_prepared(
-            FunctionLookup::Borrowed(&admitted),
-            BTreeMap::new(),
-            &program.declarations,
-            100_000,
-            0,
-            PreparedCancellation::Never,
-        );
-        evaluator.utf8_materialization_budget = Utf8MaterializationBudget::fixed();
-        let ((), metrics) = measure(|| {
-            let vector = make(&mut evaluator, &program, 0x7fc0_0123, 0x8000_0000_0000_0000);
-            let expected = snapshot(row(&vector));
-            let paid = counters(&evaluator);
-            if alias_vector {
-                let witness = Arc::clone(&vector);
-                let generation = witness.generation;
-                let result = apply(&mut evaluator, &program, vector);
-                assert!(
-                    matches!(result, Err(Flow::Guard("aliased scalar update vector"))),
-                    "{result:?}"
-                );
-                assert_eq!(witness.generation, generation);
-                assert_eq!(snapshot(row(&witness)), expected);
-                assert_eq!(Arc::strong_count(&witness), 1);
-                assert!(
-                    crate::test_allocation_observer::live_bytes_matching(|p| p == expected.string)
-                        > 0
-                );
-                drop(witness);
-            } else {
-                let witness = Arc::clone(row(&vector));
-                let result = apply(&mut evaluator, &program, vector);
-                assert!(
-                    matches!(result, Err(Flow::Guard("aliased scalar update row"))),
-                    "{result:?}"
-                );
-                assert_eq!(snapshot(&witness), expected);
-                assert_eq!(Arc::strong_count(&witness), 1);
-                assert!(
-                    crate::test_allocation_observer::live_bytes_matching(|p| p == expected.string)
-                        > 0
-                );
-                drop(witness);
-            }
-            assert_eq!(counters(&evaluator), paid);
-            assert_eq!(
-                crate::test_allocation_observer::live_bytes_matching(|p| p == expected.string),
-                0
-            );
-        });
-        balanced(metrics);
-    }
-}
