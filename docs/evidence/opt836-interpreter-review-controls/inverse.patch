-#[test]
-fn unique_scalar_store_preserves_owned_leaf_identity_and_unrelated_float_bits_without_materialization(
-) {
-    let program = program();
-    let admitted = program
-        .functions
-        .iter()
-        .map(|f| (f.id.as_str(), f))
-        .collect();
-    let element = ResolvedType::Nominal {
-        declaration: hir::DeclarationId::new("update.row"),
-        arguments: vec![],
-    };
-    let identity = crate::vec_ops::field_update::resolve(&program.declarations, &element, "count")
-        .unwrap()
-        .identity()
-        .unwrap();
-    for (bits32, bits64) in [
-        (0x8000_0000, 0x7ff8_0000_0000_0042),
-        (0x7fc0_0123, 0x8000_0000_0000_0000),
-        (0xff80_0000, 0x7ff0_0000_0000_0000),
-    ] {
-        let mut observations = Vec::new();
-        for store in [false, true] {
-            let mut evaluator = Evaluator::new_prepared(
-                FunctionLookup::Borrowed(&admitted),
-                BTreeMap::new(),
-                &program.declarations,
-                100_000,
-                0,
-                PreparedCancellation::Never,
-            );
-            evaluator.utf8_materialization_budget = Utf8MaterializationBudget::fixed();
-            let ((), metrics) = measure(|| {
-                let vector = make(&mut evaluator, &program, bits32, bits64);
-                let vector_pointer = Arc::as_ptr(&vector);
-                let generation = vector.generation;
-                let capacity = vector.capacity;
-                let mut expected = snapshot(row(&vector));
-                assert_eq!(expected.count, 7);
-                assert_eq!(expected.spare32, bits32);
-                assert_eq!(expected.spare64, bits64);
-                let paid = counters(&evaluator);
-                let operands = vec![Value::Vec(vector), Value::Usize(0), Value::Int(9)];
-                if store {
-                    let result = evaluator.update_owned_vec_field(&element, &identity, operands);
-                    let Ok(Value::Vec(vector)) = result else {
-                        panic!("{result:?}")
-                    };
-                    expected.count = 9;
-                    assert_eq!(snapshot(row(&vector)), expected);
-                    assert_eq!(Arc::as_ptr(&vector), vector_pointer);
-                    assert_eq!(vector.generation, generation + 1);
-                    assert_eq!(vector.capacity, capacity);
-                    assert_eq!(vector.values.len(), 1);
-                    drop(vector);
-                } else {
-                    // Pay the ACTUAL same descriptor controls as production.
-                    // This independent no-store construction-through-Drop
-                    // control neither substitutes a store nor omits its costs.
-                    let descriptor = crate::vec_ops::field_update::replay(
-                        &program.declarations,
-                        &element,
-                        &identity,
-                    )
-                    .unwrap();
-                    let (_, field) = crate::vec_ops::field_update::position(
-                        &program.declarations,
-                        &element,
-                        &identity,
-                    )
-                    .unwrap();
-                    assert_eq!(field, ResolvedType::I64);
-                    drop(operands);
-                    drop(descriptor);
-                }
-                assert_eq!(
-                    counters(&evaluator),
-                    paid,
-                    "store materialized an owned leaf"
-                );
-            });
-            balanced(metrics);
-            observations.push(metrics);
-        }
-        // Full actual acquisition and Drop are included in both measurements;
-        // authenticated descriptor controls stay paid. The store adds no
-        // allocation/reallocation or requested backing, including row/leaf copies.
-        assert_eq!(observations[0].allocations, observations[1].allocations);
-        assert_eq!(observations[0].reallocations, observations[1].reallocations);
-        assert_eq!(observations[0].allocated, observations[1].allocated);
-        assert_eq!(observations[0].freed, observations[1].freed);
-    }
-}
