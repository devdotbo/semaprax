+            "../../../../../../docs/evidence/weighted-storage-838/amortized/tests__workspace__semantic_graph__source_inventory.rs.patch.txt"
+        ),
+        _ => return source.to_owned(),
+    };
+    super::source::apply(source, patch, true)
