+    struct Fail(usize);
+    impl WriteHook for Fail {
+        fn before_write(&self, index: usize, _: &str) -> Result<(), String> {
+            if index == self.0 {
+                Err("selected write failure".to_owned())
+            } else {
+                Ok(())
+            }
