    "source": "src/cleanup_plan/replay/selected_context/child.rs",
    "checkpoint_revision": "9a3c4fbf969340e7ee29fd9cf931586da30cf7f2",
    "archive": "docs/evidence/reference-coverage-paid-receiving-781-next-20261016/before/src/cleanup_plan/replay/selected_context/child.rs",
    "current_sha256": "8bb723f948595f9788bd1507b52c4b1c1e21f2b7519fd8d0ccefe69cf7b785ec",
    "original_sha256": "1710f802f9b90889de12bbfc6bd5ad713e02d67a605f3c9ada8413580973fe7e",
    "edits": [
      {
        "new": "\n// Actual wrapper argument, inner-result and error-transfer slots. The caller\n// acquires each full tuple on its SAME budget before forming wrapper arguments.\npub(in super::super) type ArrayReceiving<'a> = (\n    &'a mut ReplayBudget,\n    &'a ResolvedFunction,\n    usize,\n    &'a str,\n    Result<(), crate::diagnostic::Diagnostic>,\n    crate::diagnostic::Diagnostic,\n    BudgetDiagnostic,\n    Deferred,\n    Result<(), Deferred>,\n);\npub(in super::super) type NodeReceiving<'a> = (\n    &'a mut ReplayBudget,\n    &'a ResolvedFunction,\n    &'a str,\n    Result<(), crate::diagnostic::Diagnostic>,\n    crate::diagnostic::Diagnostic,\n    BudgetDiagnostic,\n    Deferred,\n    Result<(), Deferred>,\n);\nimpl ReplayBudget {\n    #[track_caller]\n    pub(in super::super) fn child_reserve_array<T>(\n        &mut self,\n        function: &ResolvedFunction,\n        count: usize,\n        phase: &str,\n    ) -> Result<(), Deferred> {\n        self.reserve_array::<T>(function, count, phase)\n            .map_err(|error| Deferred::Budget(BudgetDiagnostic(error)))\n    }\n    #[track_caller]\n    pub(in super::super) fn child_reserve_btree_node<K, V>(\n        &mut self,\n        function: &ResolvedFunction,\n        phase: &str,\n    ) -> Result<(), Deferred> {\n        self.reserve_btree_node::<K, V>(function, phase)\n            .map_err(|error| Deferred::Budget(BudgetDiagnostic(error)))\n    }\n}\n",
        "old": ""
      }
    ]
  },
