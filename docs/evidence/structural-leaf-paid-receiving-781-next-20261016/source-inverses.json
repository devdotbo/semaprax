    {
      "source": "src/cleanup_plan/replay/selected_context/child.rs",
      "before_sha256": "8bb723f948595f9788bd1507b52c4b1c1e21f2b7519fd8d0ccefe69cf7b785ec",
      "after_sha256": "8af014bc1f52d1f8cfe526cff4c2da095509cc3d900e3d54f7dea0bef80dc033",
      "before_archive": "before/src/cleanup_plan/replay/selected_context/child.rs",
      "edits": [
        {
          "old_offset": 6233,
          "new_offset": 6233,
          "before": "",
          "after": "\n// Additional actual same-ledger primitive calls for the complete structural\n// family. No caller may manufacture BudgetDiagnostic from a child Diagnostic.\npub(in super::super) type CloneReceiving<'a, T> = (\n    &'a mut ReplayBudget,\n    &'a ResolvedFunction,\n    &'a T,\n    &'a str,\n    Result<(), crate::diagnostic::Diagnostic>,\n    crate::diagnostic::Diagnostic,\n    BudgetDiagnostic,\n    Deferred,\n    Result<(), Deferred>,\n);\npub(in super::super) type VecReceiving<'a, T> = (\n    &'a mut ReplayBudget,\n    &'a ResolvedFunction,\n    &'a mut Vec<T>,\n    usize,\n    &'a str,\n    Result<(), crate::diagnostic::Diagnostic>,\n    crate::diagnostic::Diagnostic,\n    BudgetDiagnostic,\n    Deferred,\n    Result<(), Deferred>,\n);\nimpl ReplayBudget {\n    #[track_caller]\n    pub(in super::super) fn child_reserve_clone<T: super::super::ClonePayload>(\n        &mut self,\n        function: &ResolvedFunction,\n        value: &T,\n        phase: &str,\n    ) -> Result<(), Deferred> {\n        self.reserve_clone(function, value, phase)\n            .map_err(|error| Deferred::Budget(BudgetDiagnostic(error)))\n    }\n    #[track_caller]\n    pub(in super::super) fn child_reserve_vec<T>(\n        &mut self,\n        function: &ResolvedFunction,\n        values: &mut Vec<T>,\n        additional: usize,\n        phase: &str,\n    ) -> Result<(), Deferred> {\n        self.reserve_vec(function, values, additional, phase)\n            .map_err(|error| Deferred::Budget(BudgetDiagnostic(error)))\n    }\n}\npub(in super::super) mod receiving;\n"
        }
      ]
    },
