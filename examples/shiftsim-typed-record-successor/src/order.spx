module shiftsim.order;
use type @id("shiftsim.patient") from shiftsim.request_schema as Patient;

@id("shiftsim.order.patients")
fn patients_by_dispatch_key(patients: own Vec<Patient>) -> Vec<Patient>
{
    vec_sort_by<Patient>(patients, "priority:asc,arrival:asc,id:asc,service:asc,deadline:asc")
}

@id("shiftsim.order.servers")
fn servers_by_id(servers: own Vec<string>) -> Vec<string>
{
    vec_sort_owned<string>(servers)
}

@id("shiftsim.order.unique_sorted_server_ids")
fn sorted_servers_have_unique_ids(servers: borrow Vec<string>) -> bool
{
    // The caller retains servers_by_id order; primitive String slots retain that exact byte order.
    // Equal byte lengths plus a full prefix match is exact UTF-8/NUL equality.
    let length = vec_len<string>(servers);
    let mut index = 1usize;
    let mut valid = true;
    while valid && index < length {
        let previous = vec_str_at(servers, index - 1usize);
        let current = vec_str_at(servers, index);
        valid = str_len_bytes(previous) != str_len_bytes(current) || !str_starts_with(current, previous);
        index = index + 1usize;
        valid && index < length
    }
    valid
}
