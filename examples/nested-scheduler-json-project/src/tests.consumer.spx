@id("scheduler.tests.malformed")
fn test_malformed() -> i64
{
    let raw = [123u8];
    let input = bytes_copy(array_as_slice(raw));
    let outcome = decode(bytes_as_slice(input), 1usize);
    match own outcome { Outcome::Ready { value: _request } => 1, Outcome::Error { code, offset, field } => if code == 1 && field == 0 { 0 } else { 1 }, }
}
