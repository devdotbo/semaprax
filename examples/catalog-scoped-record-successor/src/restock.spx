module catalog.restock;
use type @id("catalog.input_item") from catalog.request_schema as InputItem;
use type @id("catalog.request") from catalog.request_schema as Request;
use type @id("catalog.output_item") from catalog.response_schema as Item;
use type @id("catalog.metrics") from catalog.response_schema as Metrics;
use type @id("catalog.report") from catalog.response_schema as Report;
use type @id("catalog.result") from catalog.model as CatalogResult;
use function @id("catalog.valid_sorted_tags") from catalog.order as valid_sorted_tags;
use function @id("catalog.valid_sorted_items") from catalog.order as valid_sorted_items;
use function @id("catalog.selected") from catalog.order as selected;

@id("catalog.empty_report")
fn empty_report() -> Report
{
    Report { items: vec_with_capacity<Item>(0usize), metrics: Metrics { selected: 0, stock: 0, checksum: 0 } }
}

@id("catalog.run")
fn run(request: own Request) -> CatalogResult
{
    // Validate every item before selection, including excluded items.
    match own request { Request { tags: input_tags, items: input_items } => { let sorted_tags = vec_sort_owned<string>(input_tags); let sorted_input_items = vec_sort_owned<InputItem>(input_items); if !valid_sorted_tags(sorted_tags) || !valid_sorted_items(sorted_input_items) { CatalogResult { valid: false, report: empty_report() } } else { let mut selected_items = vec_with_capacity<Item>(vec_len<InputItem>(sorted_input_items)); let mut total = 0; let mut checksum = 0; for own item in vec_into_iter<InputItem>(sorted_input_items) { let _ = match own item { InputItem { id, department, priority, stock, topup, mark } => { let include = selected(string_as_str(id), sorted_tags); if include { let adjusted_stock = stock + topup; total = total + adjusted_stock; checksum = checksum + i64_from_u8(mark); selected_items = vec_push<Item>(selected_items, Item { id: id, department: department, priority: priority, stock: adjusted_stock, mark: mark }); } 0 }, }; 0 } let ordered = vec_sort_by<Item>(selected_items, "department:asc,priority:asc,id:asc,stock:asc,mark:asc"); let count = vec_len<Item>(ordered); CatalogResult { valid: true, report: Report { items: ordered, metrics: Metrics { selected: i64_from_usize(count), stock: total, checksum: checksum } } } } }, }
}
