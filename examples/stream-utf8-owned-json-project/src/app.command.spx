module catalog.app;
use type @id("catalog.row") from catalog.schema as Row;
use type @id("catalog.request.json.stream-input") from catalog.schema as StreamInput;
use type @id("catalog.request.json.utf8.owned-result") from catalog.schema as Outcome;
use type @id("catalog.row.json.view-encode") from catalog.schema as Encoded;
use function @id("catalog.request.json.stream.normalize") from catalog.schema as normalize;
use function @id("catalog.request.json.utf8.owned.decode") from catalog.schema as decode;
use function @id("catalog.request.json.utf8.owned.encode") from catalog.schema as encode;

permit { process.args.read, process.stderr.write, process.stdin.read, process.stdout.write }

@id("catalog.receive")
fn receive(bytes: own Bytes, length: usize) -> Outcome
{
    decode(byte_range(bytes_as_slice(bytes), 0usize, length))
}

@id("catalog.bump")
fn bump(value: own Row) -> Row
{
    match own value { Row { number, text } => Row { number: number + 1, text: text }, }
}

@id("catalog.decide")
fn decide(outcome: own Outcome) -> i64
    uses { process.stdout.write }
{
    match own outcome { Outcome::Error { code, offset, field } => 2, Outcome::Decoded { labels, rows } => { if vec_len<Row>(rows) == 0usize { 2 } else { let first = vec_clone_at<Row>(rows, 0usize); let revised = bump(first); let revised_rows = vec_replace<Row>(rows, 0usize, revised); let rendered = encode(labels, revised_rows, 131072usize); match own rendered { Encoded::Refused { required } => 2, Encoded::Encoded { text } => { let bytes = str_as_bytes(string_as_str(text)); let written = stdout_write(bytes); if written == byte_len(bytes) { 0 } else { 1 } }, } } }, }
}

@id("catalog.command")
fn command() -> i64
    uses { process.stdin.read, process.stdout.write }
{
    let normalized = normalize();
    match own normalized { StreamInput::Error { code, offset, field } => 2, StreamInput::Ready { bytes, length } => { let outcome = receive(bytes, length); decide(outcome) }, }
}

@id("catalog.app.main")
fn main() -> i64
{
    0
}
